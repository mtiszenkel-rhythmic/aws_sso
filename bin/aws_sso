#!/usr/bin/env bash
# AWS SSO helpers: log in to an SSO session, open the AWS console in a
# browser, or export a profile's credentials into the current shell.
#
# Works under both zsh and bash, either executed as a script or sourced.
# Sourcing with no arguments just defines the functions, which makes it
# safe to source from ~/.zshrc or ~/.bashrc:
#
#   . /path/to/aws_sso
#
# That defines aws_sso_login, aws_sso_console and aws_sso_export. The login
# is deliberately not named `aws_sso`, so that sourcing this file does not
# shadow the script itself if it is installed on $PATH as `aws_sso`.
#
# Note that `export` mode has to be sourced to affect the calling shell.
#
# Browser: URLs are opened with $BROWSER if set, else `open` / `xdg-open` /
# `wslview`. The opener gets the URL as its only argument, plus the
# sso-session name in AWS_SSO_SESSION, so a custom $BROWSER script can route
# per session. Ordinary browsers ignore the variable.

_aws_sso_usage() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local self="${_AWS_SSO_NAME:-aws_sso}"

  cat <<USAGE
Usage: $self [command | sso-session] [args...]

Commands:
  console, -c [profile]  Open the AWS console in a browser, federating in with
                         PROFILE's credentials (default: \$AWS_PROFILE).
  export,  -e [profile]  Export PROFILE's credentials into the calling shell
                         (default: \$AWS_PROFILE). A subprocess cannot set
                         variables in its parent, so source or eval this:
                           . $self export [profile]
                           eval "\$($self export [profile])"
                         --format process prints them as JSON instead, the
                         form credential_process wants in ~/.aws/config.
  login,   -l [session]  Log in to SESSION (default: resolved from
                         \$AWS_PROFILE). Same as giving the sso-session name
                         on its own.
  help,    -h            Show this help.

Arguments after PROFILE are passed to 'aws sso login' if the SSO token has to
be refreshed, and ignored if it is still valid. An argument starting with '-'
is never read as a profile or sso-session name, so 'console --no-browser'
still uses \$AWS_PROFILE.

When sourced, these are also available as shell functions:
  aws_sso_login [sso-session]  aws_sso_console [profile]  aws_sso_export [profile]

Any other first argument is treated as an sso-session name to log in to, and
remaining arguments are passed through to 'aws sso login'; 'login' is the
explicit spelling of the same thing. With no arguments the sso-session is
resolved from \$AWS_PROFILE.

Environment:
  AWS_SSO_LOGIN          on an expired token, 'auto' (default) logs in only
                         when a terminal is attached, '1' always, '0' never
  AWS_SSO_LOGIN_TIMEOUT  seconds to wait for a login already under way
                         elsewhere (default 180)
  BROWSER                opener for URLs; receives AWS_SSO_SESSION
  AWS_REGION             region the console opens in, overriding the profile's
                         (\$AWS_DEFAULT_REGION is honoured next, as the CLI does)

Examples:
USAGE

  printf '  %-38s %s\n' \
    "$self" "log in, session from \$AWS_PROFILE" \
    "$self corp" "log in to sso-session 'corp'" \
    "$self login corp" "the same, said explicitly" \
    "$self corp --no-browser" "extra args go to 'aws sso login'" \
    "$self console my-profile" "open the console as 'my-profile'" \
    "$self -c my-profile --no-browser" "flags reach a needed login" \
    ". $self export my-profile" "export creds into this shell" \
    "$self -e --format process my-profile" "JSON for credential_process"

  echo
  echo "Requires: aws, jq, curl."
}

# True if an argument looks like a profile / sso-session name rather than a
# flag, so that `console --no-browser` does not read the flag as a profile.
_aws_sso_is_name() {
  case "${1:-}" in
    ""|-*) return 1 ;;
    *) return 0 ;;
  esac
}

# Splits `--format env` / `--format=process` out of an export argument list.
#
# The format lands in $_AWS_SSO_FORMAT and everything else in $_AWS_SSO_ARGS.
# bash 3.2, still what macOS ships, has no namerefs, so a pair of globals is
# the only way to hand an argument list back to a caller intact.
#
# `aws sso login` has no --format of its own, so taking it from anywhere in the
# line costs nothing and lets it sit on either side of the profile name.
_aws_sso_parse_format() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  _AWS_SSO_FORMAT="env"
  _AWS_SSO_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)
        if [[ $# -lt 2 ]]; then
          echo "--format needs a value: env or process." >&2
          return 1
        fi
        _AWS_SSO_FORMAT="$2"
        shift 2
        ;;
      --format=*)
        _AWS_SSO_FORMAT="${1#--format=}"
        shift
        ;;
      *)
        _AWS_SSO_ARGS+=( "$1" )
        shift
        ;;
    esac
  done

  case "$_AWS_SSO_FORMAT" in
    env|process) return 0 ;;
    *)
      echo "Unknown --format '$_AWS_SSO_FORMAT': want env or process." >&2
      return 1
      ;;
  esac
}

# Opens a URL in the user's default browser. Works on macOS ($BROWSER or
# `open`), Linux ($BROWSER or `xdg-open`) and WSL (`wslview`).
#
# The opener is always called with the URL as its only argument, so any
# ordinary browser works. The sso-session name is passed alongside it in
# AWS_SSO_SESSION, in the environment of the opener process only, which
# lets a custom $BROWSER script route the URL (say, to a browser container
# per SSO session) while `open` and `xdg-open` simply ignore it. It may be
# empty if the session could not be determined.
_aws_sso_open_url() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local url="${1:-}"
  local sso_session="${2:-}"

  if [[ -z "$url" ]]; then
    echo "_aws_sso_open_url: no URL given." >&2
    return 1
  fi

  local opener
  for opener in "${BROWSER:-}" open xdg-open wslview; do
    [[ -n "$opener" ]] || continue
    if command -v "$opener" >/dev/null 2>&1; then
      AWS_SSO_SESSION="$sso_session" "$opener" "$url"
      return $?
    fi
  done

  echo "No URL opener found (tried \$BROWSER, open, xdg-open, wslview). URL was:" >&2
  echo "$url" >&2
  return 1
}

# Makes sure the AWS CLI is reachable, looking in the usual install locations
# if PATH does not already have it.
#
# Needed because of credential_process: that runs under whichever process
# wanted credentials, and a GUI app or launchd job carries launchd's PATH
# (/usr/bin:/bin:/usr/sbin:/sbin), not a shell's. An absolute path in the
# config line is enough to find this script, but the `aws` it shells out to --
# Homebrew's, usually -- is not on that PATH either. Prepending the directory
# we find also brings jq and curl along, since they live beside it.
_aws_sso_find_aws() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  command -v aws >/dev/null 2>&1 && return 0

  local dir
  for dir in /opt/homebrew/bin /usr/local/bin "${HOME:-}/.local/bin" /opt/local/bin; do
    if [[ -x "$dir/aws" ]]; then
      PATH="$dir:$PATH"
      export PATH
      return 0
    fi
  done

  echo "aws: command not found, and not in any of the usual install locations." >&2
  echo "Install the AWS CLI, or put it on PATH." >&2
  return 1
}

# True if the named profile is configured. Deliberately not part of
# _aws_sso_is_name: that decides whether an argument is a name or a flag, so
# a false answer there would silently fall back to $AWS_PROFILE instead of
# failing, and it is also used for sso-session names, which do not appear in
# `aws configure list-profiles`. Only called once something has already
# failed, since it costs an extra `aws` invocation (~250ms).
_aws_sso_profile_exists() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local profile="${1:-}"
  [[ -n "$profile" ]] || return 1

  local profiles
  # if the listing itself fails, say nothing rather than blame the profile
  profiles=$(aws configure list-profiles 2>/dev/null) || return 0

  command grep -Fqx -- "$profile" <<< "$profiles"
}

# The region the console should open in, resolved the way the AWS CLI resolves
# it for an API call: $AWS_REGION, then $AWS_DEFAULT_REGION, then the profile's
# own `region`. A named profile does not inherit the region of [default] -- the
# CLI does not do that either -- so this prints nothing when none is set, and
# the caller leaves the region out of the URL rather than inventing one.
_aws_sso_region() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local profile="${1:-}"

  if [[ -n "${AWS_REGION:-}" ]]; then
    printf '%s\n' "$AWS_REGION"
    return 0
  fi

  if [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
    printf '%s\n' "$AWS_DEFAULT_REGION"
    return 0
  fi

  local region
  region=$(aws configure get region --profile "$profile" 2>/dev/null) || return 1
  [[ -n "$region" ]] || return 1

  printf '%s\n' "$region"
}

# The profile a credential_process line hands off to, when that line runs
# aws_sso: `credential_process = aws_sso export --format process <profile>`
# answers `<profile>`. Prints nothing and returns 1 for a profile with no such
# line, one that runs something else, or one that names no profile.
#
# This is the link between the two halves of the pair that configuration
# generators write -- the name you use, and the profile behind it holding the
# SSO settings. Reading it here means that link only has to be stated once, in
# the line that actually produces the credentials, rather than repeated in a
# source_profile that nothing else reads.
_aws_sso_credential_process_profile() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local profile="${1:-}" line cmd noglob=""

  line=$(aws configure get credential_process --profile "$profile" 2>/dev/null) || return 1
  [[ -n "$line" ]] || return 1

  # Split the line into words. zsh does not word-split unquoted expansions
  # under its own options, and bash globs them; emulate -L localizes the first
  # for us, the second has to be switched off and back by hand.
  [ -n "${ZSH_VERSION:-}" ] && setopt shwordsplit
  case "$-" in *f*) ;; *) noglob=1 ;; esac
  set -f
  # shellcheck disable=SC2086
  set -- $line
  [[ -n "$noglob" ]] && set +f

  # A path is fine, but it has to be aws_sso rather than some other helper
  # whose arguments would mean something else entirely.
  cmd="${1:-}"
  case "${cmd##*/}" in
    aws_sso) shift ;;
    *) return 1 ;;
  esac

  case "${1:-}" in
    export|-e) shift ;;
    *) return 1 ;;
  esac

  # reuse the export parser, so --format is understood wherever it sits
  _aws_sso_parse_format "$@" || return 1
  set -- "${_AWS_SSO_ARGS[@]}"

  _aws_sso_is_name "${1:-}" || return 1
  printf '%s\n' "$1"
}

# Resolves the sso_session for a profile, following whatever supplies its
# credentials until something names a session: a credential_process running
# aws_sso, or a source_profile chain (e.g. `admin` -> `corp-sso-admin` ->
# sso-session `corp`). Prints the sso_session name, or nothing if none is
# found anywhere along the way.
_aws_sso_resolve_session() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local current_profile="${1:-}"
  local seen=" "
  local sso_session next

  while [[ -n "$current_profile" ]]; do
    # guard against cycles, whichever kind of link made them
    case "$seen" in
      *" $current_profile "*) return 1 ;;
    esac
    seen="${seen}${current_profile} "

    sso_session=$(aws configure get sso_session --profile "$current_profile" 2>/dev/null)
    if [[ -n "$sso_session" ]]; then
      printf '%s\n' "$sso_session"
      return 0
    fi

    # credential_process first: it is what actually produces this profile's
    # credentials. The exception is a profile that also has role_arn, where
    # the AWS libraries assume the role from source_profile and never run the
    # process line -- so follow the chain they follow.
    next=$(_aws_sso_credential_process_profile "$current_profile") || next=""
    if [[ -n "$next" ]] &&
       [[ -n "$(aws configure get role_arn --profile "$current_profile" 2>/dev/null)" ]]; then
      next=""
    fi
    [[ -n "$next" ]] ||
      next=$(aws configure get source_profile --profile "$current_profile" 2>/dev/null)

    current_profile=$next
  done

  return 1
}

# True if there is a controlling terminal, i.e. a human who could complete a
# login. Deliberately not `[ -t 2 ]`: botocore runs a credential_process with
# both stdout and stderr on pipes, so by that test every interactive `aws s3
# ls` would look unattended. It leaves the terminal itself attached, which is
# what this opens. Under cron or CI there is none and the open fails.
_aws_sso_have_tty() {
  { : >/dev/tty; } 2>/dev/null
}

# Refreshes an SSO session's token for a login the caller did not ask for
# directly: one triggered by an expired token part-way through console/export.
# Two things separate it from calling aws_sso_login outright.
#
# A login needs a human -- it opens a browser and waits. Somewhere nobody is
# watching (cron, CI, an IDE shelling out to terraform) that is an indefinite
# hang rather than an error, so by default it only runs when a terminal is
# attached; $AWS_SSO_LOGIN overrides in either direction.
#
# And credential_process is called once per client, so a parallel terraform run
# can ask a dozen times at once; without a lock that is a dozen browser tabs.
# One caller logs in, the rest wait for it and then let their own caller retry
# against the token it fetched.
#
# Returns 0 when the token should now be good, whether this call refreshed it
# or waited for another one to.
_aws_sso_refresh_session() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local sso_session="$1"
  shift

  case "${AWS_SSO_LOGIN:-auto}" in
    1|yes|always) ;;
    0|no|never)
      echo "SSO token for session '$sso_session' needs refreshing, but" >&2
      echo "AWS_SSO_LOGIN=${AWS_SSO_LOGIN} forbids logging in. Run:" >&2
      echo "  aws_sso login $sso_session" >&2
      return 1
      ;;
    auto)
      if ! _aws_sso_have_tty; then
        echo "SSO token for session '$sso_session' needs refreshing, but no terminal is" >&2
        echo "attached, so a login could only hang. Run this first:" >&2
        echo "  aws_sso login $sso_session" >&2
        echo "or set AWS_SSO_LOGIN=1 to attempt it anyway." >&2
        return 1
      fi
      ;;
    *)
      echo "Unknown AWS_SSO_LOGIN value '${AWS_SSO_LOGIN}': want auto, 1 or 0." >&2
      return 1
      ;;
  esac

  # mkdir is the lock because it is atomic everywhere and macOS has no flock(1).
  local lock="${TMPDIR:-/tmp}/aws_sso-login-${sso_session}.lock"
  local waited=0 holder

  while ! mkdir "$lock" 2>/dev/null; do
    if [[ "$waited" -ge "${AWS_SSO_LOGIN_TIMEOUT:-180}" ]]; then
      echo "Gave up waiting for another login to session '$sso_session'." >&2
      echo "If none is running, remove $lock and try again." >&2
      return 1
    fi
    waited=$((waited + 1))

    holder=$(cat "$lock/pid" 2>/dev/null)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      # whoever was logging in is gone; clear the lock and try to take it over
      rm -rf "$lock" 2>/dev/null
      continue
    fi

    sleep 1
    # the lock went away while its holder was alive, so that login finished
    # and the token we came for is already there
    [[ -d "$lock" ]] || return 0
  done

  # $$ is the shell, not the subshell, when this runs inside $(...) -- which
  # only makes the staleness check above conservative, never wrong. Cleaning
  # up on a signal is left to the executed case: sourced, these would be the
  # calling shell's traps to keep, and a stale lock is the lesser evil.
  printf '%s\n' "$$" > "$lock/pid" 2>/dev/null
  local trapped=0
  if [[ "${_AWS_SSO_SOURCED:-0}" -eq 0 ]]; then
    trap 'rm -rf "$lock" 2>/dev/null; exit 130' INT
    trap 'rm -rf "$lock" 2>/dev/null; exit 143' TERM
    trapped=1
  fi

  # Where a human can actually see this. stderr is the right answer whenever
  # it is a terminal, and is left alone then. When it is not, but a terminal
  # is attached, the caller is something like credential_process holding both
  # our pipes: say it to the terminal instead, or a browser window opens
  # unannounced and the device code -- printed by the login, not by us --
  # never reaches anyone.
  local rc=0
  if [ ! -t 2 ] && _aws_sso_have_tty; then
    echo "SSO token expired/invalid for session '$sso_session'; logging in again..." >/dev/tty
    aws_sso_login "$sso_session" "$@" >/dev/tty 2>&1 || rc=$?
  else
    echo "SSO token expired/invalid for session '$sso_session'; logging in again..." >&2
    # stdout belongs to the credentials, so keep the login's chatter on stderr
    aws_sso_login "$sso_session" "$@" >&2 || rc=$?
  fi

  [[ "$trapped" -eq 1 ]] && trap - INT TERM
  rm -rf "$lock" 2>/dev/null
  return "$rc"
}

# Prints a profile's credentials in the requested format (`process` or `env`),
# refreshing an expired SSO token once via aws_sso_login if needed. Credentials
# to stdout, diagnostics to stderr.
_aws_sso_credentials() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  if [[ $# -lt 2 ]]; then
    echo "_aws_sso_credentials: needs a profile and a format." >&2
    return 1
  fi

  _aws_sso_find_aws || return 1

  local profile="$1"
  local format="$2"
  shift 2
  # whatever is left are extra `aws sso login` arguments, used only if the
  # SSO token actually has to be refreshed below
  local sso_session creds

  # Profiles already being fetched further up this call chain, space-delimited
  # and inherited through the export-credentials calls below. Seeing this one
  # again means its credential_process leads back to itself, directly or around
  # a longer loop, which otherwise recurses until something runs out.
  #
  # It has to be the list rather than a bare flag: `aws` passes its whole
  # environment to every credential_process it runs, so a flag would also fire
  # on the perfectly ordinary case of asking aws_sso for a profile whose
  # credential_process names a *different* one.
  case "${_AWS_SSO_NESTED:- }" in
    *" $profile "*)
      echo "Recursion: profile '$profile' asks aws_sso for the credentials aws_sso is" >&2
      echo "already fetching for it. A credential_process line has to name the" >&2
      echo "underlying SSO profile, not the profile the line is set on." >&2
      return 1
      ;;
  esac
  local nested="${_AWS_SSO_NESTED:- }$profile "

  # Error text meaning the SSO token is missing, expired or otherwise
  # unusable, i.e. `aws sso login` should fix it. Taken from botocore's
  # SSOError / TokenRetrievalError message templates.
  local sso_errors='token has expired'
  sso_errors="$sso_errors|token .* (does not exist|is invalid)"
  sso_errors="$sso_errors|error loading sso token"
  sso_errors="$sso_errors|error when retrieving token from sso"
  sso_errors="$sso_errors|access token from sso"
  sso_errors="$sso_errors|sso session associated with this profile"
  sso_errors="$sso_errors|authorization to retrieve an sso token"
  sso_errors="$sso_errors|run aws sso login"

  if ! creds=$(_AWS_SSO_NESTED="$nested" aws configure export-credentials --profile "$profile" --format "$format" 2>&1); then
    if ! command grep -Eqi "$sso_errors" <<< "$creds"; then
      echo "export-credentials failed:" >&2
      echo "$creds" >&2
      if ! _aws_sso_profile_exists "$profile"; then
        echo "'$profile' is not a configured profile; see: aws configure list-profiles" >&2
      fi
      return 1
    fi

    sso_session=$(_aws_sso_resolve_session "$profile")

    if [[ -z "$sso_session" ]]; then
      echo "export-credentials failed with an SSO error, but no sso_session could be" >&2
      echo "resolved for profile '$profile':" >&2
      echo "$creds" >&2
      if ! _aws_sso_profile_exists "$profile"; then
        echo "'$profile' is not a configured profile; see: aws configure list-profiles" >&2
      fi
      return 1
    fi

    if ! _aws_sso_refresh_session "$sso_session" "$@"; then
      echo "Could not refresh SSO session '$sso_session'." >&2
      return 1
    fi

    if ! creds=$(_AWS_SSO_NESTED="$nested" aws configure export-credentials --profile "$profile" --format "$format" 2>&1); then
      echo "export-credentials failed after refreshing SSO token:" >&2
      echo "$creds" >&2
      return 1
    fi
  fi

  printf '%s\n' "$creds"
}

# Prints a profile's credentials: shell `export` lines to eval (env, the
# default), or the JSON credential_process reads (process). Takes --format
# anywhere in the line; what is left is a profile and then `aws sso login`
# arguments.
_aws_sso_export_creds() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  _aws_sso_parse_format "$@" || return 1
  local format="$_AWS_SSO_FORMAT"
  set -- "${_AWS_SSO_ARGS[@]}"

  local profile
  if _aws_sso_is_name "${1:-}"; then
    profile="$1"
    shift
  else
    profile="${AWS_PROFILE:-}"
  fi

  if [[ -z "$profile" ]]; then
    echo "No profile given and AWS_PROFILE is not set." >&2
    return 1
  fi

  _aws_sso_credentials "$profile" "$format" "$@"
}

# Logs in to an AWS SSO session. Takes the sso-session name, or resolves it
# from $AWS_PROFILE. Extra arguments are passed through to `aws sso login`.
aws_sso_login() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  _aws_sso_find_aws || return 1

  local sso_session
  if _aws_sso_is_name "${1:-}"; then
    sso_session="$1"
    shift
  else
    sso_session=$(_aws_sso_resolve_session "${AWS_PROFILE:-}")
  fi

  if [[ -z "$sso_session" ]]; then
    echo "No sso-session given, and none resolved from AWS_PROFILE ('${AWS_PROFILE:-unset}')." >&2
    if [[ -n "${AWS_PROFILE:-}" ]] && ! _aws_sso_profile_exists "${AWS_PROFILE}"; then
      echo "'${AWS_PROFILE}' is not a configured profile; see: aws configure list-profiles" >&2
    fi
    return 1
  fi

  # `aws sso login` opens the OIDC URL itself via $BROWSER, so export the
  # session for that browser process too
  AWS_SSO_SESSION="$sso_session" aws sso login --sso-session "$sso_session" "$@"
}

# Exports a profile's credentials into the current shell as
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN.
aws_sso_export() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  # checked before the credentials are fetched, so a wrong --format costs a
  # message rather than a browser round-trip
  _aws_sso_parse_format "$@" || return 1
  if [[ "$_AWS_SSO_FORMAT" != env ]]; then
    echo "Setting credentials in this shell needs --format env, not '$_AWS_SSO_FORMAT'." >&2
    return 1
  fi

  local creds_env
  creds_env=$(_aws_sso_export_creds "$@") || return 1

  eval "$creds_env"
}

# Opens the AWS console in a browser, federating in with a profile's
# current credentials. Handles both the aws and aws-us-gov partitions.
aws_sso_console() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local profile
  if _aws_sso_is_name "${1:-}"; then
    profile="$1"
    shift
  else
    profile="${AWS_PROFILE:-}"
  fi

  if [[ -z "$profile" ]]; then
    echo "No profile given and AWS_PROFILE is not set." >&2
    return 1
  fi

  local creds
  creds=$(_aws_sso_credentials "$profile" process "$@") || return 1

  if ! jq -e . >/dev/null 2>&1 <<< "$creds"; then
    echo "export-credentials did not return valid JSON:" >&2
    echo "$creds" >&2
    return 1
  fi

  local access_key secret_key session_token
  access_key=$(jq -r '.AccessKeyId' <<< "$creds")
  secret_key=$(jq -r '.SecretAccessKey' <<< "$creds")
  session_token=$(jq -r '.SessionToken' <<< "$creds")

  local caller_arn
  if ! caller_arn=$(aws sts get-caller-identity --profile "$profile" --query Arn --output text 2>&1); then
    echo "get-caller-identity failed:" >&2
    echo "$caller_arn" >&2
    return 1
  fi

  # Without a region in the destination the console lands wherever that
  # browser was last, which is rarely the region the profile works in.
  local region
  region=$(_aws_sso_region "$profile") || region=""

  local signin_host console_host console_url
  case "$caller_arn" in
    arn:aws-us-gov:*)
      signin_host="signin.amazonaws-us-gov.com"
      console_host="console.amazonaws-us-gov.com"
      ;;
    arn:aws:*)
      signin_host="signin.aws.amazon.com"
      console_host="console.aws.amazon.com"
      ;;
    *)
      echo "Unrecognized ARN partition in: $caller_arn" >&2
      return 1
      ;;
  esac

  if [[ -n "$region" ]]; then
    console_url="https://${console_host}/console/home?region=${region}"
  else
    console_url="https://${console_host}/"
  fi

  local session_json federation_response signin_token destination login_url
  session_json=$(jq -n \
    --arg sid "$access_key" \
    --arg key "$secret_key" \
    --arg tok "$session_token" \
    '{sessionId: $sid, sessionKey: $key, sessionToken: $tok}')

  federation_response=$(curl -s "https://${signin_host}/federation" \
    --data-urlencode "Action=getSigninToken" \
    --data-urlencode "Session=$session_json")

  if ! signin_token=$(jq -re '.SigninToken' <<< "$federation_response" 2>/dev/null); then
    echo "Failed to get SigninToken from federation endpoint. Response was:" >&2
    echo "$federation_response" >&2
    return 1
  fi

  destination=$(jq -rn --arg url "$console_url" '$url | @uri')
  login_url="https://${signin_host}/federation?Action=login&Issuer=cli&Destination=${destination}&SigninToken=${signin_token}"

  # Only resolve the session when a custom opener might act on it: `open`
  # and `xdg-open` ignore the environment, so default setups should not pay
  # for the extra `aws configure get` calls.
  local sso_session=""
  if [[ -n "${BROWSER:-}" ]]; then
    sso_session=$(_aws_sso_resolve_session "$profile")
  fi

  _aws_sso_open_url "$login_url" "$sso_session"
}

# Dispatches a command line to one of the functions above. Prints usage to
# stderr if the chosen command fails.
_aws_sso_main() {
  [ -n "${ZSH_VERSION:-}" ] && emulate -L zsh

  local rc=0

  case "${1:-}" in
    -h|--help|help)
      _aws_sso_usage
      return 0
      ;;
    -c|console)
      shift
      aws_sso_console "$@" || rc=$?
      ;;
    -e|export)
      shift
      if ! _aws_sso_parse_format "$@"; then
        rc=1
      elif [[ "$_AWS_SSO_FORMAT" != env ]]; then
        # output for another program to parse, credential_process above all.
        # Nothing to set in a shell, and nobody there to read advice about it
        # -- including the usage below, which would land in the middle of
        # whatever that program prints.
        _aws_sso_export_creds "$@" || rc=$?
        return "$rc"
      elif [[ "${_AWS_SSO_SOURCED:-0}" -eq 1 ]]; then
        aws_sso_export "$@" || rc=$?
      elif [ ! -t 1 ]; then
        # Running as a subprocess with stdout captured, i.e. the caller is
        # already doing `eval "$(... export)"`. Just hand over the creds.
        _aws_sso_export_creds "$@" || rc=$?
      else
        # Running as a subprocess straight to a terminal, so an `export`
        # here would die with the script. Print the credentials anyway, but
        # say how to actually get them into the calling shell.
        local self="${_AWS_SSO_SELF:-aws_sso}"
        local args_hint=""
        [[ $# -gt 0 ]] && args_hint=" $*"
        echo "Not sourced, so credentials cannot be set in the calling shell." >&2
        echo "Use: . $self export$args_hint" >&2
        echo "or:  eval \"\$($self export$args_hint)\"" >&2
        _aws_sso_export_creds "$@" || rc=$?
      fi
      ;;
    -l|login)
      # explicit spelling of the default case below
      shift
      aws_sso_login "$@" || rc=$?
      ;;
    *)
      aws_sso_login "$@" || rc=$?
      ;;
  esac

  if [[ "$rc" -ne 0 ]]; then
    _aws_sso_usage >&2
  fi

  return "$rc"
}

# Am I being sourced or executed?
if [ -n "${ZSH_VERSION:-}" ]; then
  case "${ZSH_EVAL_CONTEXT:-}" in
    *file*) _AWS_SSO_SOURCED=1 ;;
    *) _AWS_SSO_SOURCED=0 ;;
  esac
  _AWS_SSO_SELF="${${(%):-%x}:-aws_sso}"
  _AWS_SSO_NAME="${_AWS_SSO_SELF##*/}"
else
  case "${BASH_SOURCE[0]:-$0}" in
    "$0") _AWS_SSO_SOURCED=0 ;;
    *) _AWS_SSO_SOURCED=1 ;;
  esac
  _AWS_SSO_SELF="${BASH_SOURCE[0]:-aws_sso}"
  _AWS_SSO_NAME="${_AWS_SSO_SELF##*/}"
fi

# Executed: always dispatch. Sourced: dispatch only if given arguments, so
# that a bare `. aws_sso` from a shell rc file just defines the functions.
if [[ "$_AWS_SSO_SOURCED" -eq 0 ]] || [[ $# -gt 0 ]]; then
  _aws_sso_main "$@"
fi

